# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres local (Docker Compose, dev sem Supabase cloud)
DATABASE_URL=postgresql://nutrihub:nutrihub@db:5432/nutrihub
# Role sem bypass de RLS (ver supabase/migrations/0003_app_role_rls.sql) — usada por
# toda rota autenticada da API. Em produção, criar a role no Postgres real (Supabase
# ou equivalente) e trocar a senha aqui.
TENANT_DATABASE_URL=postgresql://nutrihub_app:nutrihub_app_dev_password@db:5432/nutrihub

# Redis (Docker Compose)
REDIS_URL=redis://redis:6379/0

# API
API_PORT=8000
# Sem valor de exemplo de propósito — gerar um próprio, ex:
# python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=
# Lista separada por vírgula das origens que podem chamar a API.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Google Identity Services — verificação do login/cadastro com Google (services/api/app/routers/auth.py).
# Client ID criado no Google Cloud Console, não é secreto.
GOOGLE_CLIENT_ID=

# Resend — envio do código de verificação de e-mail no cadastro.
RESEND_API_KEY=
EMAIL_FROM=NutriHub <no-reply@isdev.online>

# Cloudflare R2 — foto de perfil da página pública. Criar bucket + token S3
# ("Object Read & Write", escopado só nesse bucket) no dashboard da Cloudflare.
# Tudo vazio = upload desabilitado (a rota responde 503, resto da API sobe normal).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nutrihub-public
# Domínio custom apontado pro bucket, sem barra no fim. NÃO usar o *.r2.dev:
# a Cloudflare rate-limita e não recomenda pra produção.
R2_PUBLIC_BASE_URL=https://cdn.isdev.online
# Bucket privado (foto de paciente/receita, logo): SEM domínio público, sem acesso
# público. A leitura passa por URL assinada com expiração, gerada pela API.
R2_PRIVATE_BUCKET=nutrihub-private

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
# Mesmo Client ID de GOOGLE_CLIENT_ID acima — usado no browser pelo Google Identity
# Services, por isso precisa do prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
