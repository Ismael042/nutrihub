  },
  "dependencies": {
    "@nutrihub/shared": "workspace:*",
    "next": "14.2.35",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.14.10",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.59.2"
  }
}
