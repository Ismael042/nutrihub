{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "nutrihub-web",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-14",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"routes": [
		{ "pattern": "nutrihub.isdev.online", "custom_domain": true }
	],
	"vars": {
		"NEXT_PUBLIC_API_URL": "https://api-nutrihub.isdev.online",
		"NEXT_PUBLIC_SITE_URL": "https://nutrihub.isdev.online"
	}
}
